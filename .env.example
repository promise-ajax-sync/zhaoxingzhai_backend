APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# 开发阶段允许 Flutter Web 的随机端口；生产环境必须改成精确 HTTPS 域名。
APP_CORS_ORIGINS=http://127.0.0.1:5173
APP_MAX_REQUEST_BYTES=131072
APP_RATE_LIMIT_REQUESTS=20
APP_RATE_LIMIT_WINDOW_SECONDS=60
# 只有部署在可信反向代理后并正确清洗 X-Forwarded-For 时才设为 true。
APP_TRUST_PROXY_HEADERS=false
APP_DEVICE_HASH_SECRET=replace-with-a-long-random-secret
APP_ACCESS_TOKEN_SECRET=replace-with-another-long-random-secret
APP_ACCESS_TOKEN_MINUTES=30
APP_REFRESH_TOKEN_DAYS=30
APP_EMAIL_TOKEN_MINUTES=30
APP_MEDIA_ROOT=media
APP_AVATAR_MAX_BYTES=2097152

# 正式环境配置 SMTP 后才会真实发送邮箱验证码；开发环境接口会返回一次性调试验证码。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# PostgreSQL：首版接口不会强制连接数据库，启用持久化后使用。
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/zhaoxingzhai

# OpenAI 兼容接口；未填写 API_KEY 时自动使用本地降级回答。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=90
AI_TEMPERATURE=0.4
